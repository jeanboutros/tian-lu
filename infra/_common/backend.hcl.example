# _common/backend.hcl.example — TEMPLATE for the S3 remote state backend on Floci.
# Usage per stage:  terraform init -backend-config=../../_common/backend.hcl \
#                                   -backend-config="key=dev/20-network-hub/terraform.tfstate"
#
# The state bucket + lock table are created by live/00-backend-bootstrap (which itself uses
# LOCAL state — chicken/egg). Every OTHER stage uses this S3 backend.
#
# Refs: https://developer.hashicorp.com/terraform/language/settings/backends/s3
#       state locking — https://developer.hashicorp.com/terraform/language/state/locking

bucket = "tf-state-dev"
region = "us-east-1"

# Per-env, per-stage key. Override `key` on the CLI so this file stays generic:
#   -backend-config="key=dev/<NN-stage>/terraform.tfstate"
key = "dev/PLACEHOLDER/terraform.tfstate"

# State locking. Requires DynamoDB conditional writes (verify with preflight G3).
# Alternative on Terraform >= 1.10: drop dynamodb_table and set `use_lockfile = true`
# for S3-native locking (needs Floci S3 conditional PutObject — also verify).
dynamodb_table = "tf-locks-dev"

# Point the backend at Floci and relax real-AWS-only checks.
access_key = "111111111111" # dev AKID
secret_key = "test"

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
use_path_style              = true

endpoints = {
  s3       = "http://localhost:4566"
  dynamodb = "http://localhost:4566"
}
